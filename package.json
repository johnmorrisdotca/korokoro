{
  "name": "@johnmorrisdotca/korokoro",
  "version": "1.4.0",
  "description": "Dice roller and dice notation parser with exact odds for every roll. A ready-made dice tray with real dice sounds, history and stats; any die from d2 to d1000, mixed dice, hold and reroll, Fate dice, keep and drop, exploding dice and rerolls; seeded rolls anyone can verify. Zero dependencies, TypeScript, React.",
  "keywords": [
    "dice",
    "dice-roller",
    "roller",
    "roll",
    "dice-notation",
    "notation",
    "rpg",
    "ttrpg",
    "trpg",
    "tabletop",
    "roleplay",
    "dnd",
    "d&d",
    "dungeons",
    "dragons",
    "pathfinder",
    "roll20",
    "d20",
    "d6",
    "d100",
    "d30",
    "fate",
    "fudge",
    "exploding-dice",
    "advantage",
    "dice-pool",
    "probability",
    "odds",
    "random",
    "rng",
    "prng",
    "seeded",
    "fair-dice",
    "board-game",
    "typescript",
    "react"
  ],
  "homepage": "https://johnmorrisdotca.github.io/korokoro/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/korokoro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/korokoro.git"
  },
  "license": "MIT",
  "author": {
    "name": "John Morris",
    "email": "john@johnmorris.ca",
    "url": "https://johnmorris.ca"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./sounds": {
      "types": "./dist/ui/sounds.data.d.ts",
      "import": "./dist/ui/sounds.data.js",
      "default": "./dist/ui/sounds.data.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SOUNDS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "sounds": "node scripts/sounds.mjs",
    "docs:make": "node scripts/docs.mjs",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
